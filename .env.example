# HL multi-model config. Copy to `.env` (gitignored) and fill real keys.
# The run-set: which model keys to run. The key is ALSO the curve label +
# the per-model round directory name. Append a key here + its 4 lines below
# to add a model — no code change required.
MODELS=glm,deepseek,claude

# Each key needs: _PROVIDER (default openai), _BASE_URL (optional),
#                 _MODEL (required), _API_KEY (required).
GLM_PROVIDER=openai
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.6
GLM_API_KEY=replace-me

DEEPSEEK_PROVIDER=openai
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=replace-me

CLAUDE_PROVIDER=anthropic
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_API_KEY=replace-me
